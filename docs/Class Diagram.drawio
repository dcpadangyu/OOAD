    <diagram id="kNo9MdE8-4pIfF2Q9F3H" name="Page-2">
        <mxGraphModel dx="2976" dy="1357" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="3300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&quot;data&quot;: &quot;\n%%{init: {\&quot;theme\&quot;: \&quot;base\&quot;, \&quot;themeVariables\&quot;: {\&quot;background\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;lineColor\&quot;: \&quot;#000000\&quot;, \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;fontFamily\&quot;: \&quot;Arial\&quot;}}}%%\n\nclassDiagram\ndirection TB\n\nclass NguoiDung {\n    &lt;&lt;abstract&gt;&gt;\n    - int maNguoiDung\n    - string hoTen\n    - string email\n    - string soDienThoai\n    - string matKhau\n    - string trangThai\n    + dangNhap()\n    + dangXuat()\n    + capNhatThongTin()\n    + doiMatKhau()\n}\n\nclass KhachHang {\n    - string diaChi\n    - Date ngayDangKy\n    + dangKy()\n    + xemSanPham()\n    + themVaoGioHang()\n    + datHang()\n    + xemDonHang()\n    + guiYeuCauKhieuNai()\n    + xemLichSuMuaHang()\n    + apDungVoucher()\n    + chatHoTro()\n    + goiAudioOnly()\n    + quanLyDiaChiGiaoHang()\n}\n\nclass NhanVien {\n    - string maNhanVien\n    - Date ngayVaoLam\n    - double luong\n    + themSanPham()\n    + capNhatSanPham()\n    + xoaSanPham()\n    + quanLyDanhMuc()\n    + quanLyGiaBan()\n    + quanLyVoucher()\n    + quanLyTrangThaiTaiKhoan()\n    + capNhatTonKhoTheoSize()\n    + moCuocChat()\n    + traLoiChat()\n    + quanLyDonHang()\n    + xuLyThanhToan()\n    + lapHoaDon()\n    + lapPhieuNhap()\n    + xuLyYeuCauKhieuNai()\n    + lapBaoCao()\n}\n\nclass VaiTro {\n    - int maVaiTro\n    - string tenVaiTro\n    - string moTa\n    + themVaiTro()\n    + capNhatVaiTro()\n    + xoaVaiTro()\n    + ganQuyen()\n}\n\nclass Quyen {\n    - int maQuyen\n    - string tenQuyen\n    - string moTa\n    + themQuyen()\n    + capNhatQuyen()\n    + xoaQuyen()\n}\n\nclass DanhMuc {\n    - int maDanhMuc\n    - string tenDanhMuc\n    - string moTa\n    - boolean trangThai\n    + themDanhMuc()\n    + capNhatDanhMuc()\n    + xoaDanhMuc()\n    + hienThiDanhMuc()\n}\n\nclass ThuongHieu {\n    - int maThuongHieu\n    - string tenThuongHieu\n    - string quocGia\n    - string moTa\n    + themThuongHieu()\n    + capNhatThuongHieu()\n    + xoaThuongHieu()\n    + hienThiThuongHieu()\n}\n\nclass SanPham {\n    - int maSanPham\n    - string tenSanPham\n    - string moTa\n    - double giaBan\n    - string hinhAnh\n    - string trangThai\n    + capNhatThongTin()\n    + capNhatGiaBan()\n    + kiemTraTrangThai()\n    + hienThiThongTin()\n}\n\nclass KhuyenMai {\n    - string maVoucher\n    - string loaiGiam\n    - double giaTriGiam\n    - double donToiThieu\n    - string trangThai\n    + kiemTraHieuLuc()\n    + apDung()\n    + taoVoucher()\n    + capNhatVoucher()\n    + voHieuHoaVoucher()\n}\n\nclass HoTroChat {\n    - string maPhienChat\n    - string trangThai\n    + guiTinNhan()\n    + guiAnh()\n    + guiLinkSanPham()\n}\n\nclass CuocGoi {\n    - string nhaCungCap\n    - string cheDo = audio-only\n    - string tenPhong\n    + moPhongJitsiAudioOnly()\n    + giaiPhongKetNoi()\n}\n\n\n\n\n\n\n\nclass ChiTietSanPham {\n    - int maChiTietSP\n    - string maSKU\n    - string kichCo\n    - string mauSac\n    - int soLuongTon\n    - double giaNhap\n    - double giaBan\n    - string trangThai\n    + capNhatSoLuong()\n    + capNhatTonKhoTheoSize()\n    + capNhatGia()\n    + kiemTraTonKho()\n    + capNhatTrangThai()\n}\n\nclass DiaChiGiaoHang {\n    - int maDiaChi\n    - string hoTenNguoiNhan\n    - string soDienThoai\n    - string tinhThanh\n    - string quanHuyen\n    - string phuongXa\n    - string diaChiChiTiet\n    - string ghiChu\n    - boolean macDinh\n    - boolean trangThai\n    + themDiaChi()\n    + capNhatDiaChi()\n    + xoaDiaChi()\n    + datLamDiaChiMacDinh()\n    + kiemTraThongTin()\n    + hienThiDiaChi()\n}\n\nclass GioHang {\n    - int maGioHang\n    - Date ngayCapNhat\n    + themSanPham()\n    + xoaSanPham()\n    + capNhatSoLuong()\n    + tinhTongTien()\n    + lamTrongGioHang()\n    + xemGioHang()\n}\n\nclass ChiTietGioHang {\n    - int maChiTietGioHang\n    - int soLuong\n    - double donGia\n    + capNhatSoLuong()\n    + tinhThanhTien()\n    + kiemTraSoLuong()\n}\n\nclass DonHang {\n    - int maDonHang\n    - Date ngayDat\n    - string trangThai\n    - string diaChiGiaoHang\n    - string soDienThoaiNhan\n    - double tongTien\n    - double phiVanChuyen\n    - double tienGiamGia\n    - string ghiChu\n    + taoDonHang()\n    + capNhatTrangThai()\n    + tinhTongTien()\n    + huyDonHang()\n    + xemChiTietDonHang()\n    + xacNhanDonHang()\n}\n\nclass ChiTietDonHang {\n    - int maChiTietDonHang\n    - int soLuong\n    - double donGia\n    - double thanhTien\n    + tinhThanhTien()\n    + capNhatSoLuong()\n    + xemChiTiet()\n}\n\nclass ThanhToan {\n    - int maThanhToan\n    - string phuongThuc\n    - double soTien\n    - Date ngayThanhToan\n    - string trangThai\n    - string maGiaoDich\n    + taoThanhToan()\n    + xuLyThanhToan()\n    + xacNhanThanhToan()\n    + hoanTien()\n    + kiemTraTrangThai()\n}\n\nclass HoaDon {\n    - int maHoaDon\n    - string soHoaDon\n    - Date ngayLap\n    - string tenNguoiMua\n    - string maSoThue\n    - string diaChiNguoiMua\n    - double tongTienHang\n    - double tienGiamGia\n    - double thueVAT\n    - double tongThanhToan\n    - string trangThaiHoaDon\n    + lapHoaDon()\n    + tinhTongTien()\n    + xemChiTietHoaDon()\n    + capNhatThongTinHoaDon()\n    + huyHoaDon()\n    + kiemTraTrangThai()\n}\n\nclass NhaCungCap {\n    - int maNhaCungCap\n    - string tenNhaCungCap\n    - string soDienThoai\n    - string email\n    - string diaChi\n    - string trangThai\n    + themNhaCungCap()\n    + capNhatNhaCungCap()\n    + xoaNhaCungCap()\n    + xemThongTin()\n}\n\nclass PhieuNhap {\n    - int maPhieuNhap\n    - Date ngayNhap\n    - double tongTien\n    - string ghiChu\n    + taoPhieuNhap()\n    + themChiTietPhieuNhap()\n    + tinhTongTien()\n    + xacNhanNhapKho()\n    + huyPhieuNhap()\n}\n\nclass ChiTietPhieuNhap {\n    - int maChiTietPhieuNhap\n    - int soLuong\n    - double donGiaNhap\n    - double thanhTien\n    + tinhThanhTien()\n    + capNhatSoLuong()\n    + capNhatDonGia()\n}\n\nclass YeuCauKhieuNai {\n    - int maYeuCau\n    - string tieuDe\n    - string noiDung\n    - Date ngayGui\n    - string trangThai\n    - string loaiYeuCau\n    + taoYeuCau()\n    + capNhatYeuCau()\n    + huyYeuCau()\n    + xemTrangThai()\n    + danhGiaKetQua()\n}\n\nclass PhanHoiYeuCau {\n    - int maPhanHoi\n    - string noiDung\n    - Date ngayPhanHoi\n    - string tepDinhKem\n    + taoPhanHoi()\n    + capNhatPhanHoi()\n    + xemPhanHoi()\n}\n\nclass BaoCaoThongKe {\n    - int maBaoCao\n    - string loaiBaoCao\n    - Date tuNgay\n    - Date denNgay\n    - Date ngayTao\n    - double tongDoanhThu\n    - int tongDonHang\n    + taoBaoCao()\n    + thongKeDoanhThu()\n    + thongKeDonHang()\n    + thongKeSanPham()\n    + xuatBaoCao()\n}\n\nNguoiDung &lt;|-- KhachHang\nNguoiDung &lt;|-- NhanVien\n\nNhanVien \&quot;*\&quot; --&gt; \&quot;1\&quot; VaiTro : duoc gan\nVaiTro \&quot;*\&quot; -- \&quot;*\&quot; Quyen : bao gom\n\nDanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : phan loai\nThuongHieu \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : thuoc thuong hieu\nSanPham \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietSanPham : co bien the\n\nKhachHang \&quot;1\&quot; *-- \&quot;0..*\&quot; DiaChiGiaoHang : quan ly dia chi\nKhachHang \&quot;1\&quot; -- \&quot;1\&quot; GioHang : so huu\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang : gom\nChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietGioHang : duoc them vao\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : dat\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : gom\nChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonHang : duoc dat mua\n\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : co giao dich\nDonHang \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon : phat hanh\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThanhToan : xu ly\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoaDon : lap\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap : lap\nNhaCungCap \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap : cung cap\nPhieuNhap \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuNhap : gom\nChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuNhap : duoc nhap\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai : gui\nDonHang \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai : lien quan\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai : xu ly\nYeuCauKhieuNai \&quot;1\&quot; *-- \&quot;0..*\&quot; PhanHoiYeuCau : co phan hoi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiYeuCau : tao\n\nBaoCaoThongKe ..&gt; DonHang : thong ke\nBaoCaoThongKe ..&gt; ChiTietDonHang : tong hop\n\n    KhuyenMai \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang : ap dung\n    NhanVien ..&gt; KhuyenMai : quan ly\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoTroChat : mo phien\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoTroChat : xu ly\n    HoTroChat \&quot;1\&quot; *-- \&quot;1..*\&quot; TinNhan\n    TinNhan \&quot;1\&quot; *-- \&quot;0..*\&quot; TepDinhKem\n    TinNhan ..&gt; SanPham : lien ket\n    HoTroChat \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : goi audio-only\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : tham gia\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : ho tro\nclassDef monochrome fill:#ffffff,stroke:#000000,color:#000000\nclass NguoiDung,KhachHang,NhanVien,VaiTro,Quyen,DanhMuc,ThuongHieu,SanPham,ChiTietSanPham,DiaChiGiaoHang,GioHang,ChiTietGioHang,DonHang,ChiTietDonHang,ThanhToan,HoaDon,NhaCungCap,PhieuNhap,ChiTietPhieuNhap,YeuCauKhieuNai,PhanHoiYeuCau,BaoCaoThongKe monochrome&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="Vb1QhMMWw0xO4oMi25RG-1">
