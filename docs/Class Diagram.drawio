                <UserObject label="" mermaidData="{&quot;data&quot;: &quot;\n%%{init: {\&quot;theme\&quot;:\&quot;base\&quot;,\&quot;themeVariables\&quot;:{\&quot;background\&quot;:\&quot;#ffffff\&quot;,\&quot;primaryColor\&quot;:\&quot;#ffffff\&quot;,\&quot;primaryTextColor\&quot;:\&quot;#000000\&quot;,\&quot;primaryBorderColor\&quot;:\&quot;#000000\&quot;,\&quot;lineColor\&quot;:\&quot;#000000\&quot;,\&quot;secondaryColor\&quot;:\&quot;#ffffff\&quot;,\&quot;secondaryTextColor\&quot;:\&quot;#000000\&quot;,\&quot;secondaryBorderColor\&quot;:\&quot;#000000\&quot;,\&quot;tertiaryColor\&quot;:\&quot;#ffffff\&quot;,\&quot;tertiaryTextColor\&quot;:\&quot;#000000\&quot;,\&quot;tertiaryBorderColor\&quot;:\&quot;#000000\&quot;,\&quot;fontFamily\&quot;:\&quot;Arial\&quot;}}}%%\n\nclassDiagram\n    direction TB\n\n    class NguoiDung {\n        &lt;&lt;Abstract&gt;&gt;\n        #String maNguoiDung\n        #String hoTen\n        #String email\n        #String soDienThoai\n        #String tenDangNhap\n        #String matKhauMaHoa\n        #boolean trangThaiTaiKhoan\n        +dangNhap()\n        +dangXuat()\n        +quenMatKhau()\n        +doiMatKhau()\n        +capNhatThongTin()\n    }\n\n    class KhachHang {\n        -String diaChiMacDinh\n        +dangKy()\n        +xemLichSuMuaHang()\n        +guiYeuCauKhieuNai()\n        +capNhatDiaChi()\n        +xemThongTinCaNhan()\n        +xemDanhSachDonHang()\n        +themSanPhamVaoGio()\n        +datHang()\n        +theoDoiDonHang()\n        +thanhToanDonHang()\n        +huyDonHang()\n    }\n\n    class NhanVien {\n        -String maNhanVien\n        -Date ngayVaoLam\n        +taoTaiKhoanNhanVien()\n        +suaThongTinNhanVien()\n        +phanQuyen()\n        +xemDanhSachKhachHang()\n        +xemLichSuMuaHang(maKhachHang)\n        +xacNhanThanhToan()\n        +theoDoiTonKho()\n        +kiemTraTinhTrangHang()\n        +xemDanhSachYeuCau()\n        +themSanPham()\n        +suaSanPham()\n        +anSanPham()\n        +xuLyDonHang()\n        +lapPhieuNhap()\n        +lapHoaDon()\n        +xemBaoCaoThongKe()\n        +quanLyDanhMuc()\n        +quanLyGiaBan()\n        +quanLyVoucher()\n        +quanLyTrangThaiTaiKhoan()\n        +capNhatTonKhoTheoSize()\n        +moCuocChat()\n        +traLoiChat()\n    }\n\n    class VaiTro {\n        -String maVaiTro\n        -String tenVaiTro\n        -String moTa\n        +themQuyen()\n        +xoaQuyen()\n        +capNhatVaiTro()\n        +kiemTraQuyen()\n    }\n\n    class Quyen {\n        -String maQuyen\n        -String tenQuyen\n        -String moTa\n        +kiemTraQuyen()\n        +capNhatQuyen()\n    }\n\n    class DanhMuc {\n        -String maDanhMuc\n        -String tenDanhMuc\n        -String moTa\n        -String trangThai\n        +themDanhMuc()\n        +suaDanhMuc()\n        +xoaDanhMuc()\n        +layDanhSachSanPham()\n        +anDanhMuc()\n    }\n\n    class ThuongHieu {\n        -String maThuongHieu\n        -String tenThuongHieu\n        -String moTa\n        -String quocGia\n        -String trangThai\n        +themThuongHieu()\n        +suaThuongHieu()\n        +xoaThuongHieu()\n        +layDanhSachSanPham()\n    }\n\n    class SanPham {\n        -String maSanPham\n        -String tenSanPham\n        -String moTa\n        -String hinhAnh\n        -double giaBan\n        -String trangThai\n        +timKiem(tuKhoa)\n        +locSanPham(thuongHieu, danhMuc, size, mauSac, giaTu, giaDen)\n        +xemChiTiet()\n        +themSanPham()\n        +suaSanPham()\n        +xoaSanPham()\n        +capNhatGiaBan(giaMoi)\n        +kiemTraTrangThai()\n        +layDanhSachBienThe()\n    }\n\n    class ChiTietSanPham {\n        -String maChiTietSP\n        -String kichCo\n        -String mauSac\n        -int soLuongTon\n        -int mucCanhBao\n        +kiemTraTonKho(soLuong)\n        +truTonKho(soLuong)\n        +congTonKho(soLuong)\n        +layTinhTrangHang()\n        +capNhatMucCanhBao(mucMoi)\n        +kiemTraCanNhapHang()\n    }\n\n    class GioHang {\n        -String maGioHang\n        -double tongTienTamTinh\n        -Date ngayCapNhat\n        +themVaoGioHang()\n        +xemGioHang()\n        +capNhatGioHang()\n        +xoaKhoiGioHang()\n        +xoaTatCa()\n        +tinhTongTien()\n        +kiemTraGioHang()\n    }\n\n    class ChiTietGioHang {\n        -int soLuong\n        -double donGia\n        -double thanhTien\n        +capNhatSoLuong(soLuongMoi)\n        +tinhThanhTien()\n        +kiemTraSoLuongHopLe()\n    }\n\n    class DonHang {\n        -String maDonHang\n        -Date ngayDat\n        -double tongTien\n        -double giamGia\n        -String maVoucher\n        -String hoTenNguoiNhan\n        -String soDienThoaiNhan\n        -String diaChiGiaoHang\n        -String trangThaiDonHang\n        -String lyDoHuy\n        +datHang()\n        +muaNgay()\n        +huyDonHang()\n        +kiemTraDieuKienHuy()\n        +capNhatTrangThai()\n        +theoDoiTinhTrang()\n        +locDonHang()\n        +timKiemDonHang()\n        +xemChiTiet()\n        +tinhTongTien()\n        +apDungKhuyenMai(maVoucher)\n        +capNhatThongTinGiaoHang()\n    }\n\n    class HoTroChat {\n        -String maPhienChat\n        -String tieuDe\n        -String trangThai\n        -Date ngayTao\n        -Date ngayCapNhat\n        +taoPhienChat()\n        +guiTinNhan()\n        +danhDauDaDoc()\n        +themNhanVienHoTro()\n        +dongPhienChat()\n        +guiAnh()\n        +guiLinkSanPham()\n    }\n\n    class TinNhan {\n        -String maTinNhan\n        -String noiDung\n        -String loaiTinNhan\n        -Date thoiGianGui\n        -boolean daDoc\n        -String productId\n        +gui()\n        +thuHoi()\n        +dinhKemAnh()\n        +dinhKemSanPham()\n        +taoLienKetSanPham()\n    }\n\n    class TepDinhKem {\n        -String maTep\n        -String loaiTep\n        -String duongDan\n        -long kichThuoc\n        +taiLen()\n        +xoa()\n    }\n\n    class CuocGoi {\n        -String maCuocGoi\n        -String kenh\n        -String nhaCungCap\n        -String cheDo\n        -String tenPhong\n        -String trangThai\n        -Date batDau\n        -Date ketThuc\n        +batDauCuocGoi()\n        +ketThucCuocGoi()\n        +tuChoiCuocGoi()\n        +moPhongJitsiAudioOnly()\n        +giaiPhongKetNoi()\n    }\n\n    class KhuyenMai {\n        -String maVoucher\n        -String tenVoucher\n        -String moTa\n        -String loaiGiam\n        -double giaTriGiam\n        -double giamToiDa\n        -double donToiThieu\n        -Date ngayBatDau\n        -Date ngayKetThuc\n        -int soLuongToiDa\n        -int soLuongDaDung\n        -String trangThai\n        +kiemTraDieuKien(tamTinh)\n        +kiemTraHieuLuc()\n        +tinhTienGiam(tamTinh)\n        +apDung(tamTinh)\n        +huyApDung()\n        +taoVoucher()\n        +capNhatVoucher()\n        +voHieuHoaVoucher()\n    }\n\n    class ChiTietDonHang {\n        -int soLuong\n        -double donGia\n        -double thanhTien\n        +tinhThanhTien()\n        +capNhatSoLuong()\n        +layThongTinSanPham()\n    }\n\n    class ThanhToan {\n        -String maThanhToan\n        -String phuongThucThanhToan\n        -String trangThaiThanhToan\n        -double soTien\n        -Date ngayThanhToan\n        -String noiDungChuyenKhoan\n        -String ghiChu\n        +taoThanhToan()\n        +xacNhanThanhToan()\n        +kiemTraTrangThai()\n        +capNhatTrangThai()\n        +hoanTien()\n    }\n\n    class HoaDon {\n        -String maHoaDon\n        -String soHoaDon\n        -Date ngayLap\n        -String tenNguoiMua\n        -String maSoThue\n        -String diaChiNguoiMua\n        -double tongTienHang\n        -double tienGiamGia\n        -double thueVAT\n        -double tongThanhToan\n        -String trangThaiHoaDon\n        +lapHoaDon()\n        +tinhTongTien()\n        +xemChiTietHoaDon()\n        +capNhatThongTinHoaDon()\n        +huyHoaDon()\n        +kiemTraTrangThai()\n    }\n\n    class NhaCungCap {\n        -String maNCC\n        -String tenNCC\n        -String soDienThoai\n        -String email\n        -String diaChi\n        -String trangThai\n        +themNhaCungCap()\n        +suaThongTin()\n        +xoaNhaCungCap()\n        +layDanhSachPhieuNhap()\n    }\n\n    class PhieuNhap {\n        -String maPhieuNhap\n        -Date ngayNhap\n        -double tongTienNhap\n        -String ghiChu\n        -String trangThai\n        +themPhieuNhap()\n        +suaPhieuNhap()\n        +xoaPhieuNhap()\n        +xemChiTietPhieuNhap()\n        +tinhTongTien()\n        +xacNhanNhapKho()\n        +huyPhieuNhap()\n    }\n\n    class ChiTietPhieuNhap {\n        -int soLuongNhap\n        -double donGiaNhap\n        -double thanhTien\n        +tinhThanhTien()\n        +capNhatSoLuongNhap()\n        +capNhatDonGiaNhap()\n    }\n\n    class YeuCauKhieuNai {\n        -String maYeuCau\n        -String loaiYeuCau\n        -String tieuDe\n        -String noiDung\n        -String hinhAnhDinhKem\n        -String trangThaiYeuCau\n        -Date ngayGui\n        -String mucUuTien\n        +guiYeuCau()\n        +tiepNhanYeuCau()\n        +phanLoaiYeuCau()\n        +xuLyYeuCau()\n        +capNhatTrangThaiYeuCau()\n        +theoDoiYeuCau()\n        +dongYeuCau()\n    }\n\n    class PhanHoiYeuCau {\n        -String maPhanHoi\n        -String noiDungPhanHoi\n        -Date ngayPhanHoi\n        -String tepDinhKem\n        +taoPhanHoi()\n        +suaPhanHoi()\n        +xemChiTietPhanHoi()\n    }\n\n    class BaoCaoThongKe {\n        -Date tuNgay\n        -Date denNgay\n        -Date ngayLap\n        +thongKeMatHangBanChay(tuNgay, denNgay, soLuong)\n        +thongKeDoanhThu(tuNgay, denNgay, theoKieu)\n        +thongKeDonHang(tuNgay, denNgay)\n        +thongKeTonKho()\n        +xuatBaoCao()\n    }\n\n    NguoiDung &lt;|-- KhachHang\n    NguoiDung &lt;|-- NhanVien\n\n    NhanVien \&quot;*\&quot; --&gt; \&quot;1\&quot; VaiTro\n    VaiTro \&quot;*\&quot; -- \&quot;*\&quot; Quyen\n\n    DanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham\n    ThuongHieu \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham\n\n    SanPham \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietSanPham\n\n    KhachHang \&quot;1\&quot; -- \&quot;1\&quot; GioHang\n    GioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang\n    ChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietGioHang\n\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\n    DonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang\n    ChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDonHang\n\n    DonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan\n    DonHang \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThanhToan\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoaDon\n\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap\n    NhaCungCap \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap\n    PhieuNhap \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuNhap\n    ChiTietSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuNhap\n\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai\n    DonHang \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai\n    YeuCauKhieuNai \&quot;1\&quot; *-- \&quot;0..*\&quot; PhanHoiYeuCau\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiYeuCau\n\n    BaoCaoThongKe ..&gt; DonHang\n    BaoCaoThongKe ..&gt; ChiTietDonHang\n    BaoCaoThongKe ..&gt; ChiTietSanPham\n\n    KhuyenMai \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang : ap dung\n    NhanVien ..&gt; KhuyenMai : quan ly\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoTroChat : mo phien\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoTroChat : xu ly\n    HoTroChat \&quot;1\&quot; *-- \&quot;1..*\&quot; TinNhan\n    TinNhan \&quot;1\&quot; *-- \&quot;0..*\&quot; TepDinhKem\n    TinNhan ..&gt; SanPham : lien ket\n    HoTroChat \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : goi audio-only\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : tham gia\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; CuocGoi : ho tro\n    classDef monochrome fill:#ffffff,stroke:#000000,color:#000000;\n    class NguoiDung,KhachHang,NhanVien,VaiTro,Quyen monochrome;\n    class DanhMuc,ThuongHieu,SanPham,ChiTietSanPham monochrome;\n    class GioHang,ChiTietGioHang,DonHang,ChiTietDonHang monochrome;\n    class ThanhToan,HoaDon,NhaCungCap,PhieuNhap,ChiTietPhieuNhap monochrome;\n    class KhuyenMai monochrome;\n    class HoTroChat,TinNhan,TepDinhKem,CuocGoi monochrome;\n    class YeuCauKhieuNai,PhanHoiYeuCau,BaoCaoThongKe monochrome;&quot;, &quot;config&quot;: null, &quot;version&quot;: &quot;12&quot;}" id="kAO2e-KVxleJdoGJaGhE-272">
