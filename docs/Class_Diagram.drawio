                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;fontFamily&#39;: &#39;Arial&#39;,\n    &#39;fontSize&#39;: &#39;18px&#39;,\n    &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#000000&#39;,\n    &#39;lineColor&#39;: &#39;#000000&#39;,\n    &#39;secondaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;tertiaryColor&#39;: &#39;#ffffff&#39;\n  }\n}}%%\n\nclassDiagram\ndirection TB\n\nclass DanhMuc {\n  -String maDanhMuc\n  -String tenDanhMuc\n  -String moTa\n  -String trangThai\n  +themDanhMuc(tenDanhMuc, moTa) void\n  +suaDanhMuc(maDanhMuc, tenDanhMuc, moTa) void\n  +xoaDanhMuc(maDanhMuc) void\n  +anDanhMuc(maDanhMuc) void\n}\n\nclass ThuongHieu {\n  -String maThuongHieu\n  -String tenThuongHieu\n  -String moTa\n  -String trangThai\n  +themThuongHieu(tenThuongHieu, moTa) void\n  +suaThuongHieu(maThuongHieu, tenThuongHieu, moTa) void\n  +xoaThuongHieu(maThuongHieu) void\n}\n\nclass SanPham {\n  -String maSanPham\n  -String tenSanPham\n  -String moTa\n  -String hinhAnh\n  -double giaBan\n  -String trangThai\n  +timKiemSanPham(tuKhoa) List\n  +locSanPham(maDanhMuc, maThuongHieu, giaMin, giaMax) List\n  +xemChiTiet(maSanPham) SanPham\n  +themSanPham(tenSanPham, moTa, hinhAnh, giaBan) String\n  +suaSanPham(maSanPham, tenSanPham, moTa, hinhAnh, giaBan) void\n  +xoaSanPham(maSanPham) void\n}\n\nclass ChiTietSanPham {\n  -String maChiTietSP\n  -String kichCo\n  -String mauSac\n  -int soLuongTon\n  -int mucCanhBao\n  +kiemTraTonKho(maChiTietSP, soLuongCan) boolean\n  +tinhTonKho(maChiTietSP) int\n  +capNhatTonKho(maChiTietSP, soLuong) void\n}\n\nclass BaoCaoThongKe {\n  -Date tuNgay\n  -Date denNgay\n  -Date ngayLap\n  +thongKeDoanhThu(tuNgay, denNgay) double\n  +thongKeSanPhamBanChay(tuNgay, denNgay) List\n  +thongKeDonHang(tuNgay, denNgay) double\n  +thongKeTonKho() List\n}\n\nclass KhachHang {\n  -String maKhachHang\n  -String hoTen\n  -String email\n  -String soDienThoai\n  -String tenDangNhap\n  -String matKhau\n  -String trangThaiKichHoat\n  -Date ngayDangKy\n  +dangKy(hoTen, email, soDienThoai, tenDangNhap, matKhau) boolean\n  +dangNhap(tenDangNhap, matKhau) boolean\n  +dangXuat() void\n  +quenMatKhau(email) boolean\n  +doiMatKhau(matKhauCu, matKhauMoi) boolean\n  +capNhatThongTin(hoTen, email, soDienThoai) void\n  +xemLichSuMuaHang(maKhachHang) List\n  +xemThongTinCaNhan() KhachHang\n}\n\nclass NhanVien {\n  -String maNhanVien\n  -String hoTen\n  -String email\n  -String soDienThoai\n  -String tenDangNhap\n  -String matKhau\n  -String trangThaiKichHoat\n  -Date ngayVaoLam\n  +dangNhap(tenDangNhap, matKhau) boolean\n  +dangXuat() void\n  +quenMatKhau(email) boolean\n  +doiMatKhau(matKhauCu, matKhauMoi) boolean\n  +capNhatThongTin(hoTen, email, soDienThoai) void\n  +themNhanVien(hoTen, email, soDienThoai, tenDangNhap, matKhau) String\n  +suaThongTinNhanVien(maNhanVien, hoTen, email, soDienThoai) void\n  +phanQuyen(maNhanVien, maVaiTro) boolean\n}\n\nclass Quyen {\n  -String maQuyen\n  -String tenQuyen\n  -String moTa\n  +kiemTraQuyen(maNhanVien, maQuyen) boolean\n  +themQuyen(tenQuyen, moTa) void\n  +xoaQuyen(maQuyen) void\n  +capNhatQuyen(maQuyen, tenQuyen, moTa) void\n}\n\nclass VaiTro {\n  -String maVaiTro\n  -String tenVaiTro\n  -String moTa\n  +themQuyen(maVaiTro, maQuyen) void\n  +xoaQuyen(maVaiTro, maQuyen) void\n  +capNhatVaiTro(tenVaiTro, moTa) void\n  +kiemTraQuyen(maQuyen) boolean\n}\n\nclass GioHang {\n  -String maGioHang\n  -double tongTienTamTinh\n  -Date ngayCapNhat\n  +themVaoGioHang(maChiTietSP, soLuong) void\n  +xemGioHang() List\n  +capNhatGioHang(maChiTietSP, soLuong) void\n  +xoaKhoiGioHang(maChiTietSP) void\n  +tinhTongTien() double\n}\n\nclass ChiTietGioHang {\n  -String maChiTietGioHang\n  -int soLuong\n  -double donGia\n  -double thanhTien\n  +capNhatSoLuong(soLuongMoi) void\n  +tinhThanhTien() double\n  +kiemTraSoLuong(soLuongCan) boolean\n}\n\nclass DonHang {\n  -String maDonHang\n  -Date ngayDat\n  -double tongTien\n  -String hoTenNguoiNhan\n  -String soDienThoaiNhan\n  -String diaChiGiaoHang\n  -String trangThaiDonHang\n  -Date ngayCapNhat\n  +taoDonHang(maKhachHang, hoTenNguoiNhan, soDienThoaiNhan, diaChiGiaoHang) String\n  +huyDonHang(maDonHang) boolean\n  +capNhatTrangThai(maDonHang, trangThaiMoi) void\n  +theoDoiTinhTrang(maDonHang) String\n  +timKiemDonHang(tuKhoa) List\n  +xemChiTiet(maDonHang) DonHang\n  +tinhTongTien(maDonHang) double\n}\n\nclass ChiTietDonHang {\n  -String maChiTietDonHang\n  -int soLuong\n  -double donGia\n  -double thanhTien\n  +tinhThanhTien() double\n  +capNhatSoLuong(soLuongMoi) void\n}\n\nclass HoaDon {\n  -String maHoaDon\n  -Date ngayLap\n  -String tenNguoiMua\n  -String diaChiNguoiMua\n  -double tongTienHang\n  -double tienGiamGia\n  -double tongThanhToan\n  -String trangThaiHoaDon\n  +lapHoaDon(maDonHang) String\n  +tinhTongTien() double\n  +xemChiTietHoaDon(maHoaDon) HoaDon\n  +huyHoaDon(maHoaDon) boolean\n}\n\nclass ThanhToan {\n  -String maThanhToan\n  -String phuongThucThanhToan\n  -String trangThaiThanhToan\n  -double soTien\n  -Date ngayThanhToan\n  -String maGiaoDich\n  +taoThanhToan(maDonHang, phuongThucThanhToan, soTien) String\n  +xacNhanThanhToan(maThanhToan) boolean\n  +kiemTraTrangThai(maThanhToan) String\n  +capNhatTrangThai(maThanhToan, trangThaiMoi) void\n}\n\nclass PhieuNhap {\n  -String maPhieuNhap\n  -Date ngayNhap\n  -double tongTienNhap\n  -String ghiChu\n  -String trangThai\n  +themPhieuNhap(ghiChu) String\n  +xemChiTietPhieuNhap(maPhieuNhap) PhieuNhap\n  +tinhTongTien(maPhieuNhap) double\n}\n\nclass ChiTietPhieuNhap {\n  -String maChiTietPhieuNhap\n  -int soLuongNhap\n  -double donGiaNhap\n  -double thanhTien\n  +tinhThanhTien() double\n  +capNhatSoLuongNhap(soLuongNhap) void\n}\n\nclass YeuCauKhieuNai {\n  -String maYeuCau\n  -String loaiYeuCau\n  -String tieuDe\n  -String noiDung\n  -String trangThaiYeuCau\n  -Date ngayGui\n  +guiYeuCau(loaiYeuCau, tieuDe, noiDung) String\n  +tiepNhanYeuCau(maYeuCau) void\n  +phanLoaiYeuCau(maYeuCau, loaiYeuCau) void\n  +xuLyYeuCau(maYeuCau, noiDungXuLy) void\n  +capNhatTrangThaiYeuCau(maYeuCau, trangThaiMoi) void\n}\n\nclass PhanHoiYeuCau {\n  -String maPhanHoi\n  -String noiDungPhanHoi\n  -Date ngayPhanHoi\n  +taoPhanHoi(maYeuCau, noiDungPhanHoi) String\n  +suaPhanHoi(maPhanHoi, noiDungPhanHoi) void\n  +xemChiTietPhanHoi(maPhanHoi) PhanHoiYeuCau\n}\n\nclass DiaChiGiaoHang {\n  -String maDiaChi\n  -String soNha\n  -String tenDuong\n  -String tenPhuong\n  -String tenThanhPho\n  +themDiaChi(soNha, tenDuong, tenPhuong, tenThanhPho) void\n  +capNhatDiaChi(maDiaChi, soNha, tenDuong, tenPhuong, tenThanhPho) void\n  +xoaDiaChi(maDiaChi) void\n  +datLamMacDinh(maDiaChi) void\n}\n\n\n%% QUAN HE SAN PHAM\nDanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : phan loai\nThuongHieu \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : thuoc thuong hieu\nSanPham \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietSanPham : co bien the\n\n%% QUAN HE KHACH HANG\nKhachHang \&quot;1\&quot; -- \&quot;0..1\&quot; GioHang : so huu\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : dat hang\nKhachHang \&quot;1\&quot; *-- \&quot;0..*\&quot; DiaChiGiaoHang : quan ly dia chi\nDonHang \&quot;0..*\&quot; -- \&quot;0..1\&quot; DiaChiGiaoHang : dia chi duoc chon\n\n%% QUAN HE GIO HANG\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang : chua\nChiTietGioHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : tham chieu\n\n%% QUAN HE DON HANG\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : chua\nChiTietDonHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : tham chieu\n\n%% QUAN HE HOA DON VA THANH TOAN\nDonHang \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon : phat sinh\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toan\n\n%% QUAN HE NHAN VIEN\nVaiTro \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : phan cong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap : lap phieu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiYeuCau : phan hoi\n\n%% QUAN HE VAI TRO VA QUYEN\nVaiTro \&quot;0..*\&quot; -- \&quot;0..*\&quot; Quyen : duoc gan\n\n%% QUAN HE KHIEU NAI\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai : gui yeu cau\nYeuCauKhieuNai \&quot;1\&quot; *-- \&quot;0..*\&quot; PhanHoiYeuCau : co phan hoi\n\n%% QUAN HE PHIEU NHAP\nPhieuNhap \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuNhap : chua\nChiTietPhieuNhap \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : nhap bien the\n\n%% QUAN HE BAO CAO - DUONG NET DUT\nBaoCaoThongKe ..&gt; DonHang : thong ke doanh thu\nBaoCaoThongKe ..&gt; ChiTietSanPham : thong ke ton kho\n\n\n%% Dinh dang tat ca cac lop\nclassDef default fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="qgMII4R52qAAR-yy7XoU-1">
