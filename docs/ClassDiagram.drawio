<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="YGRDkpx1hZoFJeFn8hog">
    <mxGraphModel dx="2205" dy="2000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction TB\n\n    %% ===== CAU HINH GIAO DIEN =====\n    %% Nen trang, vien den, chu den\n\n    classDef default fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px\n\n    %% ===== DANH MUC / THUONG HIEU / SAN PHAM =====\n\n    class DanhMuc {\n        -String maDanhMuc\n        -String tenDanhMuc\n        -String moTa\n        -String trangThai\n        +themDanhMuc(tenDanhMuc, moTa): void\n        +suaDanhMuc(maDanhMuc, tenDanhMuc, moTa): void\n        +xoaDanhMuc(maDanhMuc): void\n        +anDanhMuc(maDanhMuc): void\n    }\n\n    class ThuongHieu {\n        -String maThuongHieu\n        -String tenThuongHieu\n        -String moTa\n        -String trangThai\n        +themThuongHieu(tenThuongHieu, moTa): void\n        +suaThuongHieu(maThuongHieu, tenThuongHieu, moTa): void\n        +xoaThuongHieu(maThuongHieu): void\n        +anThuongHieu(maThuongHieu): void\n    }\n\n    class SanPham {\n        -String maSanPham\n        -String tenSanPham\n        -String moTa\n        -String hinhAnh\n        -double giaBan\n        -String trangThai\n        +timKiemSanPham(tuKhoa): List\n        +locSanPham(maDanhMuc, maThuongHieu, giaMin, giaMax): List\n        +xemChiTiet(maSanPham): SanPham\n        +themSanPham(maDanhMuc, maThuongHieu, tenSanPham, moTa, hinhAnh, giaBan): String\n        +suaSanPham(maSanPham, maDanhMuc, maThuongHieu, tenSanPham, moTa, hinhAnh, giaBan): void\n        +xoaSanPham(maSanPham): void\n        +anSanPham(maSanPham): void\n    }\n\n    class ChiTietSanPham {\n        -String maChiTietSP\n        -String kichCo\n        -String mauSac\n        -int soLuongTon\n        -int mucCanhBao\n        +themChiTietSanPham(maSanPham, kichCo, mauSac, soLuongTon, mucCanhBao): String\n        +suaChiTietSanPham(maChiTietSP, kichCo, mauSac, mucCanhBao): void\n        +kiemTraTonKho(maChiTietSP, soLuongCan): boolean\n        +tinhTonKho(maChiTietSP): int\n        +capNhatTonKho(maChiTietSP, soLuong): void\n    }\n\n    %% ===== PHAN QUYEN =====\n\n    class VaiTro {\n        -String maVaiTro\n        -String tenVaiTro\n        -String moTa\n        +themVaiTro(tenVaiTro, moTa): String\n        +xoaVaiTro(maVaiTro): boolean\n        +capNhatVaiTro(maVaiTro, tenVaiTro, moTa): void\n        +ganQuyen(maVaiTro, maQuyen): void\n        +goQuyen(maVaiTro, maQuyen): void\n        +kiemTraQuyen(maQuyen): boolean\n    }\n\n    class Quyen {\n        -String maQuyen\n        -String tenQuyen\n        -String moTa\n        +kiemTraQuyen(maNhanVien, maQuyen): boolean\n        +themQuyen(tenQuyen, moTa): void\n        +xoaQuyen(maQuyen): void\n        +capNhatQuyen(maQuyen, tenQuyen, moTa): void\n    }\n\n    %% ===== NGUOI DUNG =====\n\n    class NhanVien {\n        -String maNhanVien\n        -String hoTen\n        -String email\n        -String soDienThoai\n        -String tenDangNhap\n        -String matKhau\n        -String trangThaiKichHoat\n        -Date ngayVaoLam\n        +dangNhap(tenDangNhap, matKhau): boolean\n        +dangXuat(): void\n        +quenMatKhau(email): boolean\n        +doiMatKhau(matKhauCu, matKhauMoi): boolean\n        +capNhatThongTin(hoTen, email, soDienThoai): void\n        +themNhanVien(hoTen, email, soDienThoai, tenDangNhap, matKhau): String\n        +suaThongTinNhanVien(maNhanVien, hoTen, email, soDienThoai): void\n        +capNhatTrangThaiKichHoat(maNhanVien, trangThai): void\n        +phanQuyen(maNhanVien, maVaiTro): boolean\n    }\n\n    class KhachHang {\n        -String maKhachHang\n        -String hoTen\n        -String email\n        -String soDienThoai\n        -String tenDangNhap\n        -String matKhau\n        -String trangThaiTaiKhoan\n        -Date ngayDangKy\n        +dangKy(hoTen, email, soDienThoai, tenDangNhap, matKhau): boolean\n        +dangNhap(tenDangNhap, matKhau): boolean\n        +dangXuat(): void\n        +quenMatKhau(email): boolean\n        +doiMatKhau(matKhauCu, matKhauMoi): boolean\n        +capNhatThongTin(hoTen, email, soDienThoai): void\n        +capNhatTrangThaiTaiKhoan(maKhachHang, trangThai): void\n        +xemLichSuMuaHang(maKhachHang): List\n        +xemThongTinCaNhan(): KhachHang\n    }\n\n    %% ===== DANH GIA / KHIEU NAI / HO TRO =====\n\n    class DanhGiaKhieuNai {\n        -String maYeuCau\n        -String loaiYeuCau\n        -String tieuDe\n        -String noiDung\n        -String trangThaiYeuCau\n        -Date ngayGui\n        -int soSao\n        -String maSanPham\n        +guiYeuCau(loaiYeuCau, tieuDe, noiDung, soSao, maSanPham): String\n        +tiepNhanYeuCau(maYeuCau): void\n        +phanLoaiYeuCau(maYeuCau, loaiYeuCau): void\n        +xuLyYeuCau(maYeuCau, noiDungXuLy): void\n        +capNhatTrangThaiYeuCau(maYeuCau, trangThaiMoi): void\n    }\n\n    class PhanHoiYeuCau {\n        -String maPhanHoi\n        -String noiDungPhanHoi\n        -Date ngayPhanHoi\n        +taoPhanHoi(maYeuCau, noiDungPhanHoi): String\n        +suaPhanHoi(maPhanHoi, noiDungPhanHoi): void\n        +xemChiTietPhanHoi(maPhanHoi): PhanHoiYeuCau\n    }\n\n    class HoTro {\n        -String maHoTro\n        -String loaiNguoiGui\n        -String noiDung\n        -String loaiTinNhan\n        -String tepDinhKem\n        -String maSanPham\n        -Date thoiGianGui\n        +guiTinNhan(): void\n        +xemTinNhan(): List\n        +lienKetSanPham(maSanPham): void\n    }\n\n    %% ===== GIO HANG =====\n\n    class GioHang {\n        -String maGioHang\n        -double tongTienTamTinh\n        -Date ngayCapNhat\n        +themVaoGioHang(maChiTietSP, soLuong): void\n        +xemGioHang(): List\n        +capNhatGioHang(maChiTietSP, soLuong): void\n        +xoaKhoiGioHang(maChiTietSP): void\n        +tinhTongTien(): double\n    }\n\n    class ChiTietGioHang {\n        -String maChiTietGioHang\n        -int soLuong\n        -double donGia\n        -double thanhTien\n        +capNhatSoLuong(soLuongMoi): void\n        +tinhThanhTien(): double\n        +kiemTraSoLuong(soLuongCan): boolean\n    }\n\n    %% ===== NHAP HANG =====\n\n    class PhieuNhap {\n        -String maPhieuNhap\n        -Date ngayNhap\n        -double tongTienNhap\n        -String tenNhaCungCap\n        -String ghiChu\n        -String trangThai\n        +themPhieuNhap(maNhanVien, tenNhaCungCap, ghiChu): String\n        +xemChiTietPhieuNhap(maPhieuNhap): PhieuNhap\n        +tinhTongTien(maPhieuNhap): double\n        +xacNhanPhieuNhap(maPhieuNhap): boolean\n    }\n\n    class ChiTietPhieuNhap {\n        -String maChiTietPhieuNhap\n        -int soLuongNhap\n        -double donGiaNhap\n        -double thanhTien\n        +tinhThanhTien(): double\n        +capNhatSoLuongNhap(soLuongNhap): void\n    }\n\n    %% ===== DON HANG / THANH TOAN =====\n\n    class DonHang {\n        -String maDonHang\n        -Date ngayDat\n        -double tongTien\n        -String hoTenNguoiNhan\n        -String soDienThoaiNhan\n        -String diaChiGiaoHang\n        -String trangThaiDonHang\n        -Date ngayCapNhat\n        -double phiVanChuyen\n        -double tienGiamGia\n        +taoDonHang(maKhachHang, hoTenNguoiNhan, soDienThoaiNhan, diaChiGiaoHang, maVoucher): String\n        +huyDonHang(maDonHang): boolean\n        +capNhatTrangThai(maDonHang, trangThaiMoi): void\n        +theoDoiTinhTrang(maDonHang): String\n        +timKiemDonHang(tuKhoa): List\n        +xemChiTiet(maDonHang): DonHang\n        +tinhTongTien(maDonHang): double\n    }\n\n    class ChiTietDonHang {\n        -String maChiTietDonHang\n        -int soLuong\n        -double donGia\n        -double thanhTien\n        +tinhThanhTien(): double\n        +capNhatSoLuong(soLuongMoi): void\n    }\n\n    class LichSuTrangThaiDonHang {\n        -String maLichSu\n        -String trangThaiCu\n        -String trangThaiMoi\n        -Date thoiGianCapNhat\n        +ghiNhanLichSu(): void\n        +xemLichSuDonHang(maDonHang): List\n    }\n\n    class DiaChiGiaoHang {\n        -String maDiaChi\n        -String soNha\n        -String tenDuong\n        -String tenPhuong\n        -String tenThanhPho\n        -boolean laMacDinh\n        +themDiaChi(soNha, tenDuong, tenPhuong, tenThanhPho): void\n        +capNhatDiaChi(maDiaChi, soNha, tenDuong, tenPhuong, tenThanhPho): void\n        +xoaDiaChi(maDiaChi): void\n        +datLamMacDinh(maDiaChi): void\n    }\n\n    class HoaDon {\n        -String maHoaDon\n        -Date ngayLap\n        -double tongTienHang\n        -double phiVanChuyen\n        -double tienGiamGia\n        -double tongThanhToan\n        -String trangThaiHoaDon\n        +lapHoaDon(maDonHang): String\n        +tinhTongTien(): double\n        +xemChiTietHoaDon(maHoaDon): HoaDon\n        +huyHoaDon(maHoaDon): boolean\n    }\n\n    class ThanhToan {\n        -String maThanhToan\n        -String phuongThucThanhToan\n        -String trangThaiThanhToan\n        -double soTien\n        -Date ngayThanhToan\n        +taoThanhToan(maDonHang, phuongThucThanhToan, soTien): String\n        +xacNhanThanhToan(maThanhToan): boolean\n        +kiemTraTrangThai(maThanhToan): String\n        +capNhatTrangThai(maThanhToan, trangThaiMoi): void\n    }\n\n    %% ===== VOUCHER / BAO CAO =====\n\n    class Voucher {\n        -String maVoucher\n        -String tenVoucher\n        -String loaiGiam\n        -double giaTriGiam\n        -double giamToiDa\n        -double donToiThieu\n        -Date ngayBatDau\n        -Date ngayKetThuc\n        -Date ngayPhatHanh\n        -int soNgayCanhBaoHetHan\n        -int soLuongToiDa\n        -int soLuongConLai\n        -int soLuongMoiTaiKhoan\n        -int mucCanhBaoSoLuong\n        -String trangThai\n        +kiemTraHopLe(donHang): boolean\n        +tinhSoTienGiam(tamTinh): double\n        +themVoucher(thongTinVoucher): String\n        +suaVoucher(thongTinMoi): void\n        +xoaVoucher(): boolean\n        +voHieuHoaVoucher(): void\n        +timKiemVoucher(tuKhoa): List~Voucher~\n        +xemDanhSachVoucher(): List~Voucher~\n        +xemVoucherCuaToi(maKhachHang): List~Voucher~\n        +phanVoucher(danhSachTaiKhoan): void\n        +laySoLuotConLai(maKhachHang): int\n        +ghiNhanSuDung(): void\n        +hoanLuotSuDung(): void\n        +kiemTraSapHetSoLuong(): boolean\n        +kiemTraSapHetHan(): boolean\n    }\n\n    class BaoCaoThongKe {\n        -Date tuNgay\n        -Date denNgay\n        -Date ngayLap\n        +thongKeDoanhThu(tuNgay, denNgay): double\n        +thongKeSanPhamBanChay(tuNgay, denNgay): List\n        +thongKeDonHang(tuNgay, denNgay): double\n        +thongKeTonKho(): List\n    }\n\n    %% ===== CAC MOI QUAN HE =====\n\n    DanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham\n    ThuongHieu \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham\n    SanPham \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietSanPham\n\n    VaiTro \&quot;0..*\&quot; -- \&quot;0..*\&quot; Quyen\n    VaiTro \&quot;0..*\&quot; -- \&quot;0..*\&quot; NhanVien\n\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DanhGiaKhieuNai\n    DanhGiaKhieuNai \&quot;1\&quot; *-- \&quot;0..*\&quot; PhanHoiYeuCau\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiYeuCau\n    NhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoTro\n    KhachHang \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoTro\n\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap\n    PhieuNhap \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuNhap\n    ChiTietPhieuNhap \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham\n\n    KhachHang \&quot;1\&quot; -- \&quot;0..1\&quot; GioHang\n    GioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang\n    ChiTietGioHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham\n\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang\n    KhachHang \&quot;1\&quot; *-- \&quot;0..*\&quot; DiaChiGiaoHang\n    DiaChiGiaoHang \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang\n    DonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang\n    ChiTietDonHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham\n    DonHang \&quot;1\&quot; *-- \&quot;0..*\&quot; LichSuTrangThaiDonHang\n    NhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; LichSuTrangThaiDonHang\n    DonHang \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon\n    DonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan\n\n    Voucher \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang\n    Voucher \&quot;0..*\&quot; -- \&quot;0..*\&quot; KhachHang\n    BaoCaoThongKe ..&gt; DonHang\n    BaoCaoThongKe ..&gt; ChiTietSanPham\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Lps1Nb2lF6Ebpx-rOFgj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10 0 10 10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
