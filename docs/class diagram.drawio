        <mxGraphModel dx="2648" dy="1645" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="3300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\n  &#39;theme&#39;: &#39;base&#39;,\n  &#39;themeVariables&#39;: {\n    &#39;fontFamily&#39;: &#39;Arial&#39;,\n    &#39;fontSize&#39;: &#39;18px&#39;,\n    &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n    &#39;primaryBorderColor&#39;: &#39;#000000&#39;,\n    &#39;lineColor&#39;: &#39;#000000&#39;,\n    &#39;secondaryColor&#39;: &#39;#ffffff&#39;,\n    &#39;tertiaryColor&#39;: &#39;#ffffff&#39;\n  }\n}}%%\n\nclassDiagram\ndirection TB\n\n%% ===================== SAN PHAM &amp; KHO =====================\nclass DanhMuc {\n  -String maDanhMuc\n  -String tenDanhMuc\n  -String moTa\n  -String trangThai\n  +themDanhMuc(tenDanhMuc, moTa) void\n  +suaDanhMuc(maDanhMuc, tenDanhMuc, moTa) void\n  +xoaDanhMuc(maDanhMuc) void\n  +anDanhMuc(maDanhMuc) void\n}\n\nclass ThuongHieu {\n  -String maThuongHieu\n  -String tenThuongHieu\n  -String moTa\n  -String trangThai\n  +themThuongHieu(tenThuongHieu, moTa) void\n  +suaThuongHieu(maThuongHieu, tenThuongHieu, moTa) void\n  +xoaThuongHieu(maThuongHieu) void\n}\n\nclass SanPham {\n  -String maSanPham\n  -String tenSanPham\n  -String moTa\n  -String hinhAnh\n  -double giaBan\n  -String trangThai\n  +timKiemSanPham(tuKhoa) List\n  +locSanPham(maDanhMuc, maThuongHieu, giaMin, giaMax) List\n  +xemChiTiet(maSanPham) SanPham\n  +themSanPham(tenSanPham, moTa, hinhAnh, giaBan) String\n  +suaSanPham(maSanPham, tenSanPham, moTa, hinhAnh, giaBan) void\n  +xoaSanPham(maSanPham) void\n}\n\nclass ChiTietSanPham {\n  -String maChiTietSP\n  -String kichCo\n  -String mauSac\n  -int soLuongTon\n  -int mucCanhBao\n  +kiemTraTonKho(maChiTietSP, soLuongCan) boolean\n  +tinhTonKho(maChiTietSP) int\n  +capNhatTonKho(maChiTietSP, soLuong) void\n}\n\n%% ===================== NGUOI DUNG &amp; PHAN QUYEN =====================\nclass KhachHang {\n  -String maKhachHang\n  -String hoTen\n  -String email\n  -String soDienThoai\n  -String tenDangNhap\n  -String matKhau\n  -String trangThaiTaiKhoan\n  -Date ngayDangKy\n  +dangKy(hoTen, email, soDienThoai, tenDangNhap, matKhau) boolean\n  +dangNhap(tenDangNhap, matKhau) boolean\n  +dangXuat() void\n  +quenMatKhau(email) boolean\n  +doiMatKhau(matKhauCu, matKhauMoi) boolean\n  +capNhatThongTin(hoTen, email, soDienThoai) void\n  +xemLichSuMuaHang(maKhachHang) List\n  +xemThongTinCaNhan() KhachHang\n}\n\nclass NhanVien {\n  -String maNhanVien\n  -String hoTen\n  -String email\n  -String soDienThoai\n  -String tenDangNhap\n  -String matKhau\n  -String trangThaiKichHoat\n  -Date ngayVaoLam\n  +dangNhap(tenDangNhap, matKhau) boolean\n  +dangXuat() void\n  +quenMatKhau(email) boolean\n  +doiMatKhau(matKhauCu, matKhauMoi) boolean\n  +capNhatThongTin(hoTen, email, soDienThoai) void\n  +themNhanVien(hoTen, email, soDienThoai, tenDangNhap, matKhau) String\n  +suaThongTinNhanVien(maNhanVien, hoTen, email, soDienThoai) void\n  +phanQuyen(maNhanVien, maVaiTro) boolean\n}\n\nclass Quyen {\n  -String maQuyen\n  -String tenQuyen\n  -String moTa\n  +kiemTraQuyen(maNhanVien, maQuyen) boolean\n  +themQuyen(tenQuyen, moTa) void\n  +xoaQuyen(maQuyen) void\n  +capNhatQuyen(maQuyen, tenQuyen, moTa) void\n}\n\nclass VaiTro {\n  -String maVaiTro\n  -String tenVaiTro\n  -String moTa\n  +themQuyen(maVaiTro, maQuyen) void\n  +xoaQuyen(maVaiTro, maQuyen) void\n  +capNhatVaiTro(tenVaiTro, moTa) void\n  +kiemTraQuyen(maQuyen) boolean\n}\n\nclass DiaChiGiaoHang {\n  -String maDiaChi\n  -String soNha\n  -String tenDuong\n  -String tenPhuong\n  -String tenThanhPho\n  +themDiaChi(soNha, tenDuong, tenPhuong, tenThanhPho) void\n  +capNhatDiaChi(maDiaChi, soNha, tenDuong, tenPhuong, tenThanhPho) void\n  +xoaDiaChi(maDiaChi) void\n  +datLamMacDinh(maDiaChi) void\n}\n\n%% ===================== GIO HANG &amp; DON HANG =====================\nclass GioHang {\n  -String maGioHang\n  -double tongTienTamTinh\n  -Date ngayCapNhat\n  +themVaoGioHang(maChiTietSP, soLuong) void\n  +xemGioHang() List\n  +capNhatGioHang(maChiTietSP, soLuong) void\n  +xoaKhoiGioHang(maChiTietSP) void\n  +tinhTongTien() double\n}\n\nclass ChiTietGioHang {\n  -String maChiTietGioHang\n  -int soLuong\n  -double donGia\n  -double thanhTien\n  +capNhatSoLuong(soLuongMoi) void\n  +tinhThanhTien() double\n  +kiemTraSoLuong(soLuongCan) boolean\n}\n\nclass DonHang {\n  -String maDonHang\n  -Date ngayDat\n  -double tongTien\n  -String hoTenNguoiNhan\n  -String soDienThoaiNhan\n  -String diaChiGiaoHang\n  -String trangThaiDonHang\n  -Date ngayCapNhat\n  +taoDonHang(maKhachHang, hoTenNguoiNhan, soDienThoaiNhan, diaChiGiaoHang) String\n  +huyDonHang(maDonHang) boolean\n  +capNhatTrangThai(maDonHang, trangThaiMoi) void\n  +theoDoiTinhTrang(maDonHang) String\n  +timKiemDonHang(tuKhoa) List\n  +xemChiTiet(maDonHang) DonHang\n  +tinhTongTien(maDonHang) double\n}\n\nclass ChiTietDonHang {\n  -String maChiTietDonHang\n  -int soLuong\n  -double donGia\n  -double thanhTien\n  +tinhThanhTien() double\n  +capNhatSoLuong(soLuongMoi) void\n}\n\nclass HoaDon {\n  -String maHoaDon\n  -Date ngayLap\n  -double tongTienHang\n  -double tienGiamGia\n  -double tongThanhToan\n  -String trangThaiHoaDon\n  +lapHoaDon(maDonHang) String\n  +tinhTongTien() double\n  +xemChiTietHoaDon(maHoaDon) HoaDon\n  +huyHoaDon(maHoaDon) boolean\n}\n\nclass ThanhToan {\n  -String maThanhToan\n  -String phuongThucThanhToan\n  -String trangThaiThanhToan\n  -double soTien\n  -Date ngayThanhToan\n  +taoThanhToan(maDonHang, phuongThucThanhToan, soTien) String\n  +xacNhanThanhToan(maThanhToan) boolean\n  +kiemTraTrangThai(maThanhToan) String\n  +capNhatTrangThai(maThanhToan, trangThaiMoi) void\n}\n\n%% ===================== NHAP HANG =====================\nclass PhieuNhap {\n  -String maPhieuNhap\n  -Date ngayNhap\n  -double tongTienNhap\n  -String ghiChu\n  -String trangThai\n  +themPhieuNhap(ghiChu) String\n  +xemChiTietPhieuNhap(maPhieuNhap) PhieuNhap\n  +tinhTongTien(maPhieuNhap) double\n}\n\nclass ChiTietPhieuNhap {\n  -String maChiTietPhieuNhap\n  -int soLuongNhap\n  -double donGiaNhap\n  -double thanhTien\n  +tinhThanhTien() double\n  +capNhatSoLuongNhap(soLuongNhap) void\n}\n\n%% ===================== VOUCHER (MOI) =====================\nclass Voucher {\n  -String maVoucher\n  -String tenVoucher\n  -String moTa\n  -String loaiGiam\n  -double giaTriGiam\n  -double giamToiDa\n  -double donToiThieu\n  -Date ngayBatDau\n  -Date hanDung\n  -int tongLuotDung\n  -int gioiHanMoiKhach\n  -boolean chiKhachMoi\n  -String trangThai\n  -String phamVi\n  -boolean choPhepCSKHPhat\n  +kiemTraDieuKien(tamTinh) boolean\n  +kiemTraHieuLuc() boolean\n  +tinhSoTienGiam(tamTinh) double\n  +themVoucher() String\n  +capNhatVoucher() void\n  +voHieuHoaVoucher() void\n  +xoaVoucher() void\n  +tinhTrangHienTai() String\n  +capChoKhach(dsKhachHang, lyDo) void\n  +thuHoiVoucher(maCapVoucher) void\n}\n\nclass CapVoucher {\n  -String maCapVoucher\n  -Date ngayCap\n  -String lyDo\n  -String trangThai\n  -Date ngayDung\n  -Date ngayThuHoi\n  -String nguoiThuHoi\n  +xemVoucherCuaToi(maKhachHang) List\n  +xemLichSuCap(maVoucher) List\n  +kiemTraDuocCap(maVoucher, maKhachHang) boolean\n  +danhDauDaDung(maCapVoucher, maDonHang) void\n}\n\n%% ===================== DANH GIA (MOI) =====================\nclass DanhGia {\n  -String maDanhGia\n  -String kichCoDaChon\n  -int soSao\n  -String binhLuan\n  -Date ngayTao\n  -String trangThai\n  -String nguoiXuLy\n  -String phanHoiNoiDung\n  -Date phanHoiThoiGian\n  -boolean daAn\n  +guiDanhGia(maDonHang, maSanPham, soSao, binhLuan) String\n  +tiepNhanDanhGia(maDanhGia) void\n  +phanHoiDanhGia(maDanhGia, noiDung) void\n  +suaPhanHoi(maDanhGia, noiDung) void\n  +anDanhGia(maDanhGia, daAn) void\n  +xemDanhGia(maSanPham) List\n}\n\nclass DanhGiaTep {\n  -int stt\n  -String loai\n  -String ten\n  -String duongDan\n  +themTep(maDanhGia, tep) void\n  +xoaTep(maDanhGia, stt) void\n}\n\n%% ===================== HO TRO CHAT (MOI) =====================\nclass HoTroChat {\n  -String maPhienChat\n  -String maKhachHang\n  -String tenKhachHang\n  -String nhanVienXuLy\n  -String maNhanVienXuLy\n  -Date ngayTiepNhan\n  -String trangThai\n  -String maTinNhanKhachDaDoc\n  -String maTinNhanNhanVienDaDoc\n  -Date ngayTao\n  -Date ngayCapNhat\n  -Date ngayDong\n  -String nguoiDong\n  +taoPhienChat(maKhachHang) String\n  +tiepNhan(maPhienChat) void\n  +tiepQuan(maPhienChat) void\n  +guiTinNhan(maPhienChat, noiDung) TinNhan\n  +danhDauDaDoc(maPhienChat) void\n  +dongPhienChat(maPhienChat) void\n  +moLai(maPhienChat) void\n}\n\nclass TinNhan {\n  -String maTinNhan\n  -String loaiNguoiGui\n  -String maNguoiGui\n  -String tenNguoiGui\n  -String loaiTinNhan\n  -String noiDung\n  -String duLieuAnh\n  -String maSanPham\n  -String tenSanPham\n  -String duongDan\n  -int soSao\n  -Date thoiGianGui\n  +guiChu(noiDung) String\n  +guiAnh(duLieuAnh) String\n  +guiLinkSanPham(maSanPham) String\n  +guiDanhGiaSao(chiTiet) String\n}\n\n%% ===================== KHIEU NAI =====================\nclass YeuCauKhieuNai {\n  -String maYeuCau\n  -String loaiYeuCau\n  -String tieuDe\n  -String noiDung\n  -String trangThaiYeuCau\n  -Date ngayGui\n  +guiYeuCau(loaiYeuCau, tieuDe, noiDung) String\n  +tiepNhanYeuCau(maYeuCau) void\n  +phanLoaiYeuCau(maYeuCau, loaiYeuCau) void\n  +xuLyYeuCau(maYeuCau, noiDungXuLy) void\n  +capNhatTrangThaiYeuCau(maYeuCau, trangThaiMoi) void\n}\n\nclass PhanHoiYeuCau {\n  -String maPhanHoi\n  -String noiDungPhanHoi\n  -Date ngayPhanHoi\n  +taoPhanHoi(maYeuCau, noiDungPhanHoi) String\n  +suaPhanHoi(maPhanHoi, noiDungPhanHoi) void\n  +xemChiTietPhanHoi(maPhanHoi) PhanHoiYeuCau\n}\n\n%% ===================== BAO CAO =====================\nclass BaoCaoThongKe {\n  -Date tuNgay\n  -Date denNgay\n  -Date ngayLap\n  +thongKeDoanhThu(tuNgay, denNgay) double\n  +thongKeSanPhamBanChay(tuNgay, denNgay) List\n  +thongKeDonHang(tuNgay, denNgay) double\n  +thongKeTonKho() List\n}\n\n\n%% ===================== QUAN HE SAN PHAM =====================\nDanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : phân loại\nThuongHieu \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : thuộc\nSanPham \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietSanPham : có biến thể\n\n%% ===================== QUAN HE KHACH HANG =====================\nKhachHang \&quot;1\&quot; -- \&quot;0..1\&quot; GioHang : sở hữu\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : đặt\nKhachHang \&quot;1\&quot; *-- \&quot;0..*\&quot; DiaChiGiaoHang : có\nDonHang \&quot;0..*\&quot; -- \&quot;0..1\&quot; DiaChiGiaoHang : giao đến\n\n%% ===================== QUAN HE GIO HANG =====================\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietGioHang : chứa\nChiTietGioHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : tham chiếu\n\n%% ===================== QUAN HE DON HANG =====================\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : gồm\nChiTietDonHang \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : tham chiếu\nDonHang \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDon : xuất\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toán\n\n%% ===================== QUAN HE NHAN VIEN &amp; PHAN QUYEN =====================\nVaiTro \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : gán cho\nVaiTro \&quot;0..*\&quot; -- \&quot;0..*\&quot; Quyen : gồm\n\n%% ===================== QUAN HE NHAP HANG =====================\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhap : lập\nPhieuNhap \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuNhap : gồm\nChiTietPhieuNhap \&quot;0..*\&quot; -- \&quot;1\&quot; ChiTietSanPham : nhập biến thể\n\n%% ===================== QUAN HE VOUCHER (MOI) =====================\nVoucher \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang : áp dụng\nVoucher \&quot;1\&quot; -- \&quot;0..*\&quot; CapVoucher : được phát\nCapVoucher \&quot;0..*\&quot; -- \&quot;1\&quot; KhachHang : nhận\nCapVoucher \&quot;0..*\&quot; -- \&quot;0..1\&quot; NhanVien : do nhân viên phát\nCapVoucher \&quot;0..1\&quot; -- \&quot;0..1\&quot; DonHang : dùng cho đơn\n\n%% ===================== QUAN HE DANH GIA (MOI) =====================\nDanhGia \&quot;0..*\&quot; -- \&quot;0..1\&quot; KhachHang : viết\nDanhGia \&quot;0..*\&quot; -- \&quot;1\&quot; SanPham : đánh giá cho\nDanhGia \&quot;0..*\&quot; -- \&quot;0..1\&quot; ChiTietDonHang : cho dòng đơn\nDanhGia \&quot;1\&quot; *-- \&quot;0..*\&quot; DanhGiaTep : đính kèm\n\n%% ===================== QUAN HE HO TRO CHAT (MOI) =====================\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoTroChat : mở phiên\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HoTroChat : xử lý\nHoTroChat \&quot;1\&quot; *-- \&quot;1..*\&quot; TinNhan : gồm\n\n%% ===================== QUAN HE KHIEU NAI =====================\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauKhieuNai : gửi\nYeuCauKhieuNai \&quot;1\&quot; *-- \&quot;0..*\&quot; PhanHoiYeuCau : có phản hồi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhanHoiYeuCau : tạo phản hồi\n\n%% ===================== QUAN HE BAO CAO (NET DUT) =====================\nBaoCaoThongKe ..&gt; DonHang : thống kê\nBaoCaoThongKe ..&gt; ChiTietSanPham : thống kê tồn kho\n\nclassDef default fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="5jzok-QSXm3MIiv4j-cS-1">
